# Add these in Vercel → Project → Settings → Environment Variables
# --- API (server side, keep secret) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SHIPPING_FEE=250
FREE_SHIPPING_OVER=5000
# --- Order email notifications (Resend) ---
RESEND_API_KEY=re_your_resend_api_key
ORDER_NOTIFICATION_EMAIL=orders@your-domain.com
EMAIL_FROM="Améza Orders <orders@your-verified-domain.com>"
# --- Frontend (public, baked in at build time) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_WHATSAPP_NUMBER=+923XXXXXXXXX
# Leave VITE_API_URL empty: the API is on the same domain (/api).
